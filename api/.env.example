# ============================================================
#  EduGest API — configuração (copie para .env e preencha)
# ============================================================

# Porta da API (o OdontoWorld usa a 3000)
PORT=3001

# MySQL (mesmo container do OdontoWorld, banco separado)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=edugest_user
DB_PASSWORD=COLOQUE_A_SENHA_DO_criar-banco.sql
DB_NAME=edugest

# Chave do Firebase Admin (projeto edugest-80e0f)
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# apiKey pública do Firebase (a mesma do firebaseConfig do front).
# Usada só pelo scripts/token.js para testes pelo terminal.
FIREBASE_WEB_API_KEY=AIzaSyBErShvBxrx1PMbTQURzcSl_-RbEDKlbYg

# Origens permitidas (separe por vírgula se houver mais de uma)
CORS_ORIGINS=https://edugest.reisconsultoriatec.com

# Chave AES-256 para CPF/RG — 64 caracteres hexadecimais
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GUARDE UMA CÓPIA FORA DO SERVIDOR: sem ela os CPFs gravados não podem ser lidos.
CRYPTO_KEY=
